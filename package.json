{
  "name": "resolution",
  "private": true,
  "version": "0.1.0",
  "description": "AI Incident Resolution Platform — multi-tenant SaaS that investigates, diagnoses, remediates and verifies production incidents across a customer's ITSM, monitoring, cloud, data and infrastructure systems.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm run generate --workspace=@resolution/database",
    "db:migrate": "npm run migrate:dev --workspace=@resolution/database"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2"
}
