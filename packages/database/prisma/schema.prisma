// AI Incident Resolution Platform — core schema.
// See ARCHITECTURE.md §8 for the tenant-isolation contract: every tenant-owned model
// carries organizationId, and it is only ever set server-side from the authenticated
// session — repositories in packages/database/repositories/* enforce this, never trust
// a client-supplied organizationId.
//
// Datasource: Cloudflare D1 (SQLite dialect) — see ARCHITECTURE.md §2. SQLite has no
// native enum type, so every field that would be a Prisma `enum` on Postgres is a `String`
// here instead, with the allowed values documented in a comment and enforced by the
// corresponding Zod union at the application layer (packages/shared, packages/security,
// packages/map-servers, packages/credentials) rather than by the database schema.
// Application code must never write a value outside that list.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity & tenancy ───────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String? // null when the user only ever authenticates via SSO
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   OrganizationMember[]
  auditLogs     AuditLog[]
  approvals     Approval[]
  notifications Notification[]

  @@index([email])
}

model Organization {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  // ResolutionMode: OBSERVE_ONLY | RECOMMEND | HUMAN_APPROVED | AUTONOMOUS — see ARCHITECTURE.md §7
  resolutionMode String   @default("OBSERVE_ONLY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members            OrganizationMember[]
  credentials        Credential[]
  integrations       Integration[]
  mapServers         MapServer[]
  incidents          Incident[]
  knowledgeDocuments KnowledgeDocument[]
  runbooks           Runbook[]
  automationPolicies AutomationPolicy[]
  auditLogs          AuditLog[]
  webhookEvents      WebhookEvent[]
  notifications      Notification[]
  usageMetrics       UsageMetric[]
  subscription       Subscription?

  @@index([slug])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  // Role: OWNER | ADMIN | MEMBER | VIEWER — see packages/security/src/rbac.ts
  role           String   @default("MEMBER")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─────────────────────────── Credentials ───────────────────────────

model Credential {
  id   String @id @default(uuid())
  organizationId String
  name           String
  provider       String // e.g. "microsoft-fabric", "jira", "aws" — free-form, validated by the map-server/integration registry
  // AuthenticationType: OAUTH | API_KEY | CLIENT_SECRET | SERVICE_PRINCIPAL | BASIC_AUTH |
  // TOKEN | CUSTOM — see packages/credentials/src/credential-payload.ts
  authenticationType String
  encryptedData      String // envelope-encrypted blob; see packages/credentials/src/secret-provider.ts — never selected into API responses
  // CredentialStatus: VALID | INVALID | UNVERIFIED | EXPIRED
  status          String    @default("UNVERIFIED")
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mapServers   MapServer[]

  @@index([organizationId])
  @@index([organizationId, provider])
}

// ─────────────────────────── Integrations (incident sources) ───────────────────────────

model Integration {
  id             String @id @default(uuid())
  organizationId String
  // IncidentSourceType: JIRA | SERVICENOW | PAGERDUTY | WEBHOOK
  type         String
  name         String
  credentialId String?
  config       String     @default("{}") // e.g. Jira project key, ServiceNow instance URL
  // ConnectionStatus: CONNECTED | DEGRADED | DISCONNECTED | UNCONFIGURED
  status    String   @default("UNCONFIGURED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents    Incident[]

  @@index([organizationId])
  @@index([organizationId, type])
}

// ─────────────────────────── Map Servers ───────────────────────────

model MapServer {
  id             String @id @default(uuid())
  organizationId String
  // MapServerType: FABRIC | DATABRICKS | SNOWFLAKE | AZURE | AWS | GCP | KUBERNETES |
  // DATADOG | SPLUNK | DYNATRACE | NEW_RELIC | AIRFLOW | CUSTOM — see packages/shared
  type         String
  name         String
  credentialId String?
  environments String    @default("[]") // string[] e.g. ["prod","staging"]
  config       String    @default("{}") // provider-specific config (workspace id, region, cluster, ...)
  isMock       Boolean @default(false)
  // ConnectionStatus: CONNECTED | DEGRADED | DISCONNECTED | UNCONFIGURED
  status            String    @default("UNCONFIGURED")
  lastHealthCheckAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential   Credential?           @relation(fields: [credentialId], references: [id])
  capabilities MapServerCapability[]

  @@index([organizationId])
  @@index([organizationId, type])
}

model MapServerCapability {
  id          String  @id @default(uuid())
  mapServerId String
  key         String // e.g. "get_pipeline_run", "retry_pipeline" — matches Capability.key in code
  enabled     Boolean @default(false)
  // RiskLevel: LOW | MEDIUM | HIGH | CRITICAL
  riskLevel String
  mutating  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mapServer MapServer @relation(fields: [mapServerId], references: [id], onDelete: Cascade)

  @@unique([mapServerId, key])
  @@index([mapServerId])
}

// ─────────────────────────── Incidents ───────────────────────────

model Incident {
  id             String  @id @default(uuid())
  organizationId String
  integrationId  String?
  externalId     String // ID in the source system
  // IncidentSourceType: JIRA | SERVICENOW | PAGERDUTY | WEBHOOK
  source      String
  title       String
  description String
  // Severity: CRITICAL | HIGH | MEDIUM | LOW
  severity String
  // Priority: P1 | P2 | P3 | P4
  priority String
  // IncidentStatus: NEW | INVESTIGATING | RCA_COMPLETE | PENDING_APPROVAL | REMEDIATING |
  // VERIFYING | RESOLVED | ESCALATED | CLOSED | FAILED
  status String @default("NEW")
  service     String?
  environment String?
  resource    String?
  // MapServerType, nullable
  affectedSystem String?
  metadata       String      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration     Integration?        @relation(fields: [integrationId], references: [id])
  events          IncidentEvent[]
  evidence        IncidentEvidence[]
  investigations  Investigation[]
  rcas            RootCauseAnalysis[]
  resolutions     Resolution[]
  agentExecutions AgentExecution[]

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model IncidentEvent {
  id         String   @id @default(uuid())
  incidentId String
  type       String // e.g. "status_changed", "comment_added", "assigned"
  actor      String // "system" | "agent" | userId
  detail     String     @default("{}")
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model IncidentEvidence {
  id         String @id @default(uuid())
  incidentId String
  // EvidenceType: LOG | METRIC | CONFIG | API_RESPONSE | PIPELINE_RUN | TRACE | OTHER
  type          String
  source        String // Map Server id or "manual"
  capabilityKey String?
  summary       String
  payload       String     @default("{}")
  collectedAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// ─────────────────────────── Investigation & RCA ───────────────────────────

model Investigation {
  id         String @id @default(uuid())
  incidentId String
  // AgentExecutionStatus: RUNNING | SUCCEEDED | FAILED
  status      String    @default("RUNNING")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  summary     String?

  incident Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  steps    InvestigationStep[]

  @@index([incidentId])
}

model InvestigationStep {
  id                String   @id @default(uuid())
  investigationId   String
  mapServerId       String?
  capabilityKey     String?
  input             String     @default("{}")
  output            String     @default("{}")
  evidenceCreatedId String?
  createdAt         DateTime @default(now())

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
}

model RootCauseAnalysis {
  id         String @id @default(uuid())
  incidentId String
  summary    String
  claims     String // Claim[] — { text, claimType: FACT|INFERENCE|HYPOTHESIS, evidenceIds: string[], confidence: number } — see packages/shared/src/rca.ts
  confidence            Float
  alternativeHypotheses String     @default("[]")
  createdAt             DateTime @default(now())

  incident    Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  resolutions Resolution[]

  @@index([incidentId])
}

// ─────────────────────────── Resolution & remediation ───────────────────────────

model Resolution {
  id             String @id @default(uuid())
  incidentId     String
  rcaId          String
  proposedAction String
  mapServerId    String?
  capabilityKey  String?
  input          String    @default("{}")
  // RiskLevel: LOW | MEDIUM | HIGH | CRITICAL
  riskLevel String
  createdAt DateTime @default(now())

  incident Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  rca      RootCauseAnalysis   @relation(fields: [rcaId], references: [id])
  actions  RemediationAction[]

  @@index([incidentId])
}

model RemediationAction {
  id           String @id @default(uuid())
  resolutionId String
  // RemediationStatus: PENDING | APPROVED | EXECUTING | SUCCEEDED | FAILED | ROLLED_BACK
  status         String    @default("PENDING")
  idempotencyKey String    @unique // (incidentId, capabilityKey, runId)
  executedAt     DateTime?
  result         String      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resolution    Resolution     @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  approval      Approval?
  verifications Verification[]

  @@index([resolutionId])
}

model Approval {
  id                  String @id @default(uuid())
  remediationActionId String @unique
  // ApprovalStatus: PENDING | APPROVED | REJECTED | EXPIRED
  status          String    @default("PENDING")
  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  reason          String?

  remediationAction RemediationAction @relation(fields: [remediationActionId], references: [id], onDelete: Cascade)
  decidedBy         User?             @relation(fields: [decidedByUserId], references: [id])

  @@index([status])
}

model Verification {
  id                  String @id @default(uuid())
  remediationActionId String
  // VerificationStatus: PENDING | PASSED | FAILED | RETRYING
  status        String   @default("PENDING")
  expectedState String     @default("{}")
  actualState   String     @default("{}")
  attempt       Int      @default(1)
  checkedAt     DateTime @default(now())

  remediationAction RemediationAction @relation(fields: [remediationActionId], references: [id], onDelete: Cascade)

  @@index([remediationActionId])
}

// ─────────────────────────── Knowledge ───────────────────────────
// Vector search runs on Cloudflare Vectorize, not in D1 (SQLite has no vector type) — a
// KnowledgeEmbedding row's `id` is also its Vectorize vector id, so the two stay joinable.
// See docs/deployment.md and IMPLEMENTATION_PLAN.md Phase 7.

model KnowledgeDocument {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  sourceType     String // "incident" | "runbook" | "upload" | "manual"
  sourceId       String? // e.g. incidentId when auto-derived
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  embeddings   KnowledgeEmbedding[]

  @@index([organizationId])
}

model KnowledgeEmbedding {
  id                  String   @id @default(uuid())
  organizationId      String // duplicated onto the row so ownership is checkable without a join; the actual vector lives in Vectorize under this same id
  knowledgeDocumentId String
  chunkIndex           Int
  chunkText            String
  createdAt            DateTime @default(now())

  document KnowledgeDocument @relation(fields: [knowledgeDocumentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([knowledgeDocumentId])
}

model Runbook {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  description    String?
  service        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        RunbookStep[]

  @@index([organizationId])
}

model RunbookStep {
  id        String @id @default(uuid())
  runbookId String
  order     Int
  title     String
  detail    String

  runbook Runbook @relation(fields: [runbookId], references: [id], onDelete: Cascade)

  @@index([runbookId])
}

// ─────────────────────────── Policy & governance ───────────────────────────

model AutomationPolicy {
  id             String @id @default(uuid())
  organizationId String
  // MapServerType — see packages/shared
  mapServerType String
  capabilityKey String
  // RiskLevel: LOW | MEDIUM | HIGH | CRITICAL
  riskLevel String
  // PolicyBehavior: AUTO | APPROVAL | DENY
  behavior String
  // ResolutionMode: OBSERVE_ONLY | RECOMMEND | HUMAN_APPROVED | AUTONOMOUS
  resolutionModeFloor String   @default("OBSERVE_ONLY")
  createdAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, mapServerType, capabilityKey])
  @@index([organizationId])
}

model AuditLog {
  id String @id @default(uuid())
  // Nullable: most audit entries are org-scoped (credential created, remediation
  // executed), but account-level events (signup, login) have no organization yet —
  // see apps/api/src/routes/auth.ts. Every org-scoped write path still always sets it.
  organizationId String?
  actorType      String // "user" | "agent" | "system"
  actorId        String? // userId or agent name
  action         String // e.g. "credential.created", "remediation.executed", "user.login"
  targetType     String?
  targetId       String?
  requestId      String?
  metadata       String     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

model AgentExecution {
  id         String @id @default(uuid())
  incidentId String
  // AgentType: INVESTIGATION | KNOWLEDGE | CONTEXT | RCA | RESOLUTION | REMEDIATION |
  // VERIFICATION | INCIDENT_UPDATE
  agentType String
  // AgentExecutionStatus: RUNNING | SUCCEEDED | FAILED
  status      String    @default("RUNNING")
  input       String      @default("{}")
  output      String      @default("{}")
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// ─────────────────────────── Webhooks, notifications, usage ───────────────────────────

model WebhookEvent {
  id             String @id @default(uuid())
  organizationId String?
  // IncidentSourceType: JIRA | SERVICENOW | PAGERDUTY | WEBHOOK
  source      String
  externalId  String
  eventHash   String // idempotency: hash of the raw payload
  processedAt DateTime?
  payload     String
  createdAt   DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([source, externalId, eventHash])
  @@index([organizationId, createdAt])
}

model Notification {
  id             String @id @default(uuid())
  organizationId String
  userId         String?
  // NotificationChannel: EMAIL | SLACK | TEAMS | IN_APP
  channel   String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

model UsageMetric {
  id             String   @id @default(uuid())
  organizationId String
  metric         String // e.g. "incidents.investigated", "remediations.executed"
  value          Float
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, periodStart])
}

model Subscription {
  id             String @id @default(uuid())
  organizationId String @unique
  // SubscriptionPlan: FREE | TEAM | ENTERPRISE
  plan String @default("FREE")
  // SubscriptionStatus: ACTIVE | TRIALING | PAST_DUE | CANCELED
  status                         String    @default("TRIALING")
  billingProviderCustomerId      String?
  billingProviderSubscriptionId  String?
  currentPeriodEnd               DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
