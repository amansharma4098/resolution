# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_URL=
CLOUDFLARE_R2_BUCKET=

# apps/api — deployed as a Cloudflare Worker (see docs/deployment.md). DATABASE_URL is
# only for local Node-side Prisma tooling (a plain `file:` sqlite URL) — the deployed
# Worker gets its database via the D1 binding in wrangler.toml, not this var.
DATABASE_URL=file:./dev.db
SECRET_PROVIDER=ENCRYPTED_DB
# Production values are set via `wrangler secret put` (see docs/deployment.md), never here.
ENCRYPTION_MASTER_KEY=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
MOCK_MODE=true

# apps/web — local dev only. Production leaves this empty (set via the Cloudflare Pages
# project's own env var, not this file) so apiRequest calls resolve as same-origin
# relative paths, proxied to the Worker by functions/api/[[path]].ts — see
# docs/deployment.md and ARCHITECTURE.md §2. Local dev has no such proxy, so it needs the
# Worker's real local URL here.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Phase 7 — packages/ai's LLM client. Unset (or MOCK_MODE=true, the default above) means the
# investigation queue consumer runs against the deterministic MOCK_MODE client instead —
# the full investigate → RCA pipeline works end to end either way. Production value is set
# via `wrangler secret put ANTHROPIC_API_KEY`, never here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Forgot-password emails (packages/email). Unset (either var) means the API logs the reset
# link to the console instead of sending a real email — the full signup → forgot-password →
# reset flow still works end to end with zero external accounts, same MOCK_MODE-style
# fallback as ANTHROPIC_API_KEY above. Production values are set via
# `wrangler secret put RESEND_API_KEY` / as a plain wrangler.toml var for EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=

# Billing (packages/billing) — one-time credit-pack purchases via Stripe Checkout. Unset
# STRIPE_SECRET_KEY makes production checkout unavailable. In local MOCK_MODE it applies credits instead
# of a real charge (labeled `mock: true` in the response) — same zero-cost-by-default
# fallback as every other real-provider integration above. STRIPE_WEBHOOK_SECRET is only
# needed for the real path (verifying POST /api/webhooks/stripe's signature); irrelevant to
# the mock path, since nothing calls out to Stripe in that case. Production values are set
# via `wrangler secret put`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Deployment helpers
CLOUDFLARE_WORKER_NAME=resolution-api
CLOUDFLARE_D1_DATABASE=resolution-db
