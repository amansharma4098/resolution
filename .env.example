# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_URL=
CLOUDFLARE_R2_BUCKET=

# apps/api — deployed as a Cloudflare Worker (see docs/deployment.md). DATABASE_URL is
# only for local Node-side Prisma tooling (a plain `file:` sqlite URL) — the deployed
# Worker gets its database via the D1 binding in wrangler.toml, not this var.
DATABASE_URL=file:./dev.db
SECRET_PROVIDER=ENCRYPTED_DB
# Production values are set via `wrangler secret put` (see docs/deployment.md), never here.
ENCRYPTION_MASTER_KEY=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
MOCK_MODE=true

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8787

# Phase 7+ (not built yet)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
